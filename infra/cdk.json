{
  "app": ".venv/bin/python app.py",
  "watch": {"exclude": ["**/__pycache__", ".venv", "cdk.out", "tests"]},
  "context": {
    "iflow": {
      "region": "us-east-1",
      "account": "",
      "domain": "iflowcore.com",
      "api_subdomain": "api",
      "web_origins": ["https://iflowcore.com"],
      "alert_email": "you@example.com",
      "monthly_budget_usd": 80,
      "google_client_ids": [],
      "db_instance_class": "t4g.micro",
      "db_multi_az": false,
      "db_allocated_gb": 20,
      "db_max_gb": 100,
      "backup_days": 7,
      "cpu": 256,
      "memory_mib": 512,
      "min_tasks": 1,
      "max_tasks": 3,
      "jwt_key_id": "k1",
      "app_secret_name": "iflow-core/api/app",
      "log_retention_days": 30
    },
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:target-partitions": ["aws"]
  }
}

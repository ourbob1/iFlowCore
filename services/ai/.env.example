# Copy to .env and fill in. Comments must be on their own lines.

# --- Public endpoint (Caddy) -------------------------------------------------
# DNS A/AAAA record for this name must point at the server.
RS_AI_DOMAIN=ai.example.com
# Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# --- Access ------------------------------------------------------------------
# Client tokens: comma-separated, 32+ chars each. One per device is best so a lost
# phone can be revoked. Generate with:  openssl rand -hex 32
RS_AI_TOKENS=
# Operator token for GET /v1/telemetry/issues. Must differ from every client token.
RS_AI_ADMIN_TOKEN=

# --- Models ------------------------------------------------------------------
# ocr_llm | vlm | off
RS_AI_RECEIPT_BACKEND=ocr_llm
# llm | off
RS_AI_TAX_BACKEND=llm
RS_AI_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Pin a commit hash for reproducible deploys (blank = latest main).
RS_AI_LLM_REVISION=
# Only used with RS_AI_RECEIPT_BACKEND=vlm (needs ~20 GB RAM or a GPU).
RS_AI_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
RS_AI_VLM_REVISION=
# Tesseract languages; each must be baked into the image via OCR_LANGS below.
RS_AI_OCR_LANGS=eng
# float32 (fastest on most VPS CPUs, ~7 GB for the 1.5B model) or bfloat16 (~3.5 GB,
# fast only on CPUs with AVX512-BF16/AMX).
RS_AI_DTYPE=float32
# Torch threads; blank = all vCPUs.
RS_AI_THREADS=
# Load models at startup instead of on the first request.
RS_AI_PRELOAD=true

# --- Capacity & limits -------------------------------------------------------
# Parallel inferences; keep 1 on servers with 8 vCPUs or fewer.
RS_AI_MAX_CONCURRENCY=1
RS_AI_QUEUE_TIMEOUT_S=90
RS_AI_MAX_UPLOAD_MB=25
RS_AI_MAX_NEW_TOKENS=384
# Requests per token per minute.
RS_AI_RATE_RECEIPTS=20
RS_AI_RATE_TAX=20
RS_AI_RATE_EVENTS=30
RS_AI_TELEMETRY_RETENTION_DAYS=90
# Expose /docs (OpenAPI UI). Keep off in production.
RS_AI_DOCS=false

# --- Docker ------------------------------------------------------------------
# Memory cap for the ai container (float32 1.5B model needs ~8 GB with headroom).
AI_MEM_LIMIT=10g
# Tesseract language packs baked into the image, space-separated (e.g. "eng spa").
OCR_LANGS=eng
